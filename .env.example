# Maximum PDF size in MiB (1 MiB = 1,048,576 bytes).
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100

# Chunk size and overlap are measured in characters, not tokens.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Local development credentials only. Change the password before deployment.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=docsproject
POSTGRES_USER=docsproject
POSTGRES_PASSWORD=docsproject_local_only

# Obtain a key from https://dash.voyageai.com/ and keep it server-side.
# The selected model is voyage-4-lite with 1024-dimensional float embeddings.
VOYAGE_API_KEY=
VOYAGE_TIMEOUT_SECONDS=30
# 1–16 passages per request; lower this if your account has low rate limits.
VOYAGE_BATCH_SIZE=16

# Create a key at https://console.groq.com/keys; never commit the key.
# Generation model: qwen/qwen3.8-27b (configured in app/config.py).
GROQ_API_KEY=
GROQ_TIMEOUT_SECONDS=30
LLM_MAX_COMPLETION_TOKENS=512
# Total passage text characters sent to Groq, excluding the question and instructions.
LLM_MAX_CONTEXT_CHARS=6000

# Shared per-IP limit across POST /search and POST /questions.
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60

# Private administrator key for document uploads and deletions (X-Admin-Key header).
# Never put this key in the public frontend. Empty means mutations are disabled.
ADMIN_API_KEY=

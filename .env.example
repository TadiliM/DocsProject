# Maximum PDF size in MiB (1 MiB = 1,048,576 bytes).
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100

# Chunk size and overlap are measured in characters, not tokens.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Local development credentials only. Change the password before deployment.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=docsproject
POSTGRES_USER=docsproject
POSTGRES_PASSWORD=docsproject_local_only
